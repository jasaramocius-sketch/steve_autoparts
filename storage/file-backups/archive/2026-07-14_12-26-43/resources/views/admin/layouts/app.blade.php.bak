        .admin-sidebar .brand { padding:18px 20px; border-bottom:1px solid rgba(255,255,255,.08); font-size:18px; font-weight:700; letter-spacing:.5px; white-space:nowrap; }
        .admin-sidebar .brand i { color:#4bc5e7; }
        .admin-sidebar .nav-wrap { flex:1; overflow-y:auto;}
        .admin-sidebar .nav-wrap::-webkit-scrollbar { width:4px; }
        .admin-sidebar .nav-wrap::-webkit-scrollbar-thumb { background:rgba(255,255,255,.15); border-radius:4px; }
        .admin-sidebar .nav-section { font-size:10px; text-transform:uppercase; letter-spacing:1.2px; color:rgba(255,255,255,.3); padding:5px 20px 5px; font-weight:600; }
        .admin-sidebar .nav-item { display:flex; align-items:center; gap:12px; padding:10px 20px; color:rgba(255,255,255,.6); text-decoration:none; font-size:14px; transition:all .15s; border-left:3px solid transparent; background:transparent; }
        .admin-sidebar .nav-item:hover { background:rgba(255,255,255,.04); color:#fff; }
        .admin-sidebar .nav-item.active { background:transparent; color:#fff; border-left-color:#4bc5e7; }
        .admin-sidebar .nav-item:not(.active):hover { border-left-color:rgba(255,255,255,.15); }
        .admin-sidebar .nav-item i { width:18px; text-align:center; font-size:15px; }
        .admin-sidebar .nav-item-sub { padding-left:44px; font-size:13px; }
        .main-content { margin-left:260px; min-height:100vh; display:flex; flex-direction:column; }
        .admin-navbar { background:#fff; padding:0 24px; height:60px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #e9ecef; position:sticky; top:0; z-index:999;gap: 10px; }
        .admin-navbar .page-title { font-size:18px; font-weight:600; color:#1e1e2d; }
        .admin-navbar .nav-actions { display:flex; align-items:center; gap:12px; }
        .admin-navbar .user-dropdown { display:flex; align-items:center; gap:8px; cursor:pointer; padding:6px 12px; border-radius:8px; transition:background .15s; text-decoration:none; color:#1e1e2d; }
        .admin-navbar .user-dropdown:hover { background:#f4f6f9; }
        .admin-navbar .user-avatar { width:34px; height:34px; border-radius:50%; background:#1e1e2d; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:600; font-size:14px; }
        .admin-content { flex:1; padding:24px; }
