    $ordersThisMonthNew = isset($orders) ? $orders->filter(fn($o) => $o->created_at && $o->created_at->isCurrentMonth() && $o->status === 'pending')->count() : 0;
    $pendingCount = isset($orders) ? $orders->whereIn('status', ['pending', 'processing'])->count() : 0;
@endphp

