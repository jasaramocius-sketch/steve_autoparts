<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.review-inline-form').forEach(function(form) {
        var slug = form.dataset.slug;
        var stars = form.querySelectorAll('.star-pick');
        var ratingInput = form.querySelector('.review-rating-input');
        var textarea = form.querySelector('.review-text-input');
        var submitBtn = form.querySelector('.review-submit-btn');
        var alertEl = form.querySelector('.review-form-alert');

        stars.forEach(function(star) {
            star.addEventListener('mouseenter', function() {
                var val = parseInt(star.dataset.rating);
                stars.forEach(function(s) {
                    s.className = parseInt(s.dataset.rating) <= val ? 'fas fa-star star-pick' : 'far fa-star star-pick';
                    s.style.color = parseInt(s.dataset.rating) <= val ? '#fac451' : '#ccc';
                });
            });
            star.addEventListener('click', function() {
                ratingInput.value = star.dataset.rating;
            });
        });

        form.addEventListener('mouseleave', function() {
            var val = parseInt(ratingInput.value) || 0;
            stars.forEach(function(s) {
                s.className = parseInt(s.dataset.rating) <= val ? 'fas fa-star star-pick' : 'far fa-star star-pick';
                s.style.color = parseInt(s.dataset.rating) <= val ? '#fac451' : '#ccc';
            });
        });

        submitBtn.addEventListener('click', function() {
            var rating = parseInt(ratingInput.value);
            var text = textarea.value.trim();

            if (!rating || rating < 1 || rating > 5) {
                alertEl.className = 'review-form-alert text-danger mt-1';
                alertEl.textContent = 'Please select a rating.';
                return;
            }
            if (!text) {
                alertEl.className = 'review-form-alert text-danger mt-1';
                alertEl.textContent = 'Please write your review.';
                return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
            alertEl.classList.add('d-none');

            fetch('{{ url("/product") }}/' + slug + '/review', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ rating: rating, text: text })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    var row = form.closest('tr');
                    var reviewCell = row.querySelector('td:nth-child(2)');
                    var statusCell = row.querySelector('td:nth-child(3)');

                    var starsHtml = '';
                    for (var i = 1; i <= 5; i++) {
                        starsHtml += '<i class="fa fa-star' + (i <= rating ? ' text-warning' : '-o text-muted') + '" style="font-size:13px;"></i>';
                    }
                    reviewCell.innerHTML = '<div class="d-flex align-items-center gap-1 mb-1">' + starsHtml + '</div><p class="mb-0" style="max-width:300px;font-size:13px;color:#555;">' + (text.length > 80 ? text.substring(0, 80) + '...' : text) + '</p>';
                    statusCell.innerHTML = '<span class="badge bg-success">Reviewed</span><div class="mt-1" style="font-size:13px;">' + new Date().toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) + '</div>';

                    var pageAlert = document.getElementById('reviewPageAlert');
                    pageAlert.className = 'alert alert-success mt-3';
                    pageAlert.textContent = 'Review submitted successfully!';
                } else {
                    alertEl.className = 'review-form-alert text-danger mt-1';
                    alertEl.textContent = data.message || 'Something went wrong.';
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit';
                }
            })
            .catch(function() {
                alertEl.className = 'review-form-alert text-danger mt-1';
                alertEl.textContent = 'Something went wrong. Please try again.';
                submitBtn.disabled = false;
                submitBtn.textContent = 'Submit';
            });
        });
    });
});
</script>

@endsection
