<script>
document.addEventListener('DOMContentLoaded', function() {
    // Trigger for popup button
    const reviewPopupBtn = document.getElementById('reviewPopupBtn');
    if (reviewPopupBtn) {
      reviewPopupBtn.addEventListener('click', function() {
        // For now, show a simple alert - we can enhance this later
        toastr.info('Please select a product to review from the table above');
      });
    }

    document.querySelectorAll('.review-inline-form').forEach(function(form) {
        var slug = form.dataset.slug;
        var stars = form.querySelectorAll('.star-pick');
        var ratingInput = form.querySelector('.review-rating-input');
        var textarea = form.querySelector('.review-text-input');
        var submitBtn = form.querySelector('.review-submit-btn');
        var alertEl = form.querySelector('.review-form-alert');

        stars.forEach(function(star) {
            star.addEventListener('mouseenter', function() {
                var val = parseInt(star.dataset.rating);
                stars.forEach(function(s) {
                    s.className = parseInt(s.dataset.rating) <= val ? 'fas fa-star star-pick' : 'far fa-star star-pick';
                    s.style.color = parseInt(s.dataset.rating) <= val ? '#fac451' : '#ccc';
                });
            });
            star.addEventListener('click', function() {
                ratingInput.value = star.dataset.rating;
            });
        });

        form.addEventListener('mouseleave', function() {
            var val = parseInt(ratingInput.value) || 0;
            stars.forEach(function(s) {
                s.className = parseInt(s.dataset.rating) <= val ? 'fas fa-star star-pick' : 'far fa-star star-pick';
                s.style.color = parseInt(s.dataset.rating) <= val ? '#fac451' : '#ccc';
            });
        });

        submitBtn.addEventListener('click', function() {
            var rating = parseInt(ratingInput.value);
            var text = textarea.value.trim();

            if (!rating || rating < 1 || rating > 5) {
                alertEl.className = 'review-form-alert text-danger mt-1';
                alertEl.textContent = 'Please select a rating.';
                return;
            }
            if (!text) {
                alertEl.className = 'review-form-alert text-danger mt-1';
                alertEl.textContent = 'Please write your review.';
                return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
            alertEl.classList.add('d-none');

            fetch('{{ url("/product") }}/' + slug + '/review', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ rating: rating, text: text })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    var row = form.closest('tr');
                    var reviewCell = row.querySelector('td:nth-child(2)');
                    var statusCell = row.querySelector('td:nth-child(3)');

                    var starsHtml = '';
                    for (var i = 1; i <= 5; i++) {
                        starsHtml += '<i class="fa fa-star' + (i <= rating ? ' text-warning' : '-o text-muted') + '" style="font-size:13px;"></i>';
                    }
                    reviewCell.innerHTML = '<div class="d-flex align-items-center gap-1 mb-1">' + starsHtml + '</div><p class="mb-0" style="max-width:300px;font-size:13px;color:#555;">' + (text.length > 80 ? text.substring(0, 80) + '...' : text) + '</p>';
                    statusCell.innerHTML = '<span class="badge bg-success">Reviewed</span><div class="mt-1" style="font-size:13px;">' + new Date().toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) + '</div>';

                    toastr.success('Review submitted successfully!');
                } else {
                    alertEl.className = 'review-form-alert text-danger mt-1';
                    alertEl.textContent = data.message || 'Something went wrong.';
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit';
                }
            })
            .catch(function() {
                alertEl.className = 'review-form-alert text-danger mt-1';
                alertEl.textContent = 'Something went wrong. Please try again.';
                submitBtn.disabled = false;
                submitBtn.textContent = 'Submit';
            });
        });
    });
});

<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Write a Review</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="reviewModalAlert" class="alert alert-danger d-none mb-3"></div>
        <div class="row">
          <div class="col-md-4">
            <div class="product-info mb-3">
              <h6 class="fw-semibold mb-2">Product</h6>
              <div class="d-flex align-items-center gap-2">
                <img id="reviewProductImage" src="" alt="Product" style="width:50px;height:50px;object-fit:cover;border-radius:6px;">
                <div>
                  <a id="reviewProductLink" href="" class="fw-semibold text-dark text-decoration-none"></a>
                  <div id="reviewProductName" class="text-muted small"></div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-8">
            <div class="mb-3">
              <label class="form-label fw-semibold">Your Rating *</label>
              <div class="star-picker" id="reviewModalStarPicker">
                @for($i = 1; $i <= 5; $i++)
                  <i class="far fa-star" data-rating="{{ $i }}" style="font-size:24px;cursor:pointer;color:#ccc;transition:color .2s;"></i>
                @endfor
                <input type="hidden" name="rating" id="reviewModalRating" value="0">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Your Review *</label>
              <textarea class="form-control" id="reviewModalText" rows="3" maxlength="1000" placeholder="Share your experience with this product..."></textarea>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="reviewModalSubmitBtn">Submit Review</button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Trigger for popup button
    const reviewPopupBtn = document.getElementById('reviewPopupBtn');
    if (reviewPopupBtn) {
      reviewPopupBtn.addEventListener('click', function() {
        // For now, show a simple alert - we can enhance this later
        toastr.info('Please select a product to review from the table above');
      });
    }

    // Trigger for product page review button
    const reviewPopupBtnProduct = document.getElementById('review-popup-btn');
    if (reviewPopupBtnProduct) {
      // Get product details from the current page - only if we're on a product page
      @if(isset($product))
      const productId = {{ json_encode($product['id'] ?? 0) }};
      const productSlug = '{{ $product['slug'] ?? '' }}';
      const productName = '{{ $product['name'] ?? '' }}';
      const productImage = '{{ $product['image'] ? asset('assets/images/thumbnails/' . $product['image']) : asset('assets/images/placeholder.png') }}';
      
      reviewPopupBtnProduct.addEventListener('click', function() {
        // Show product details in modal and prefill
        document.getElementById('reviewProductImage').src = productImage;
        document.getElementById('reviewProductLink').href = '{{ route("product", $product['slug']) }}';
        document.getElementById('reviewProductName').textContent = productName;
      @else
      // Not on product page, hide the button or handle appropriately
      reviewPopupBtnProduct.style.display = 'none';
      @endif
    }
        
        // Reset form
        document.getElementById('reviewModalStarPicker').querySelectorAll('.far.fa-star').forEach(star => {
          star.className = 'far fa-star';
          star.style.color = '#ccc';
        });
        document.getElementById('reviewModalRating').value = '0';
        document.getElementById('reviewModalText').value = '';
        document.getElementById('reviewModalAlert').classList.add('d-none');
        
        // Show modal
        const modal = new bootstrap.Modal(document.getElementById('reviewModal'));
        modal.show();
      });
    }

    // Star picker for modal
    const reviewModalStarPicker = document.getElementById('reviewModalStarPicker');
    if (reviewModalStarPicker) {
      const stars = reviewModalStarPicker.querySelectorAll('i');
      stars.forEach(star => {
        star.addEventListener('mouseenter', () => {
          const val = parseInt(star.dataset.rating);
          stars.forEach(s => {
            s.className = parseInt(s.dataset.rating) <= val ? 'fas fa-star' : 'far fa-star';
            s.style.color = parseInt(s.dataset.rating) <= val ? '#fac451' : '#ccc';
          });
        });
        star.addEventListener('click', () => {
          document.getElementById('reviewModalRating').value = star.dataset.rating;
        });
      });
      reviewModalStarPicker.addEventListener('mouseleave', () => {
        const val = parseInt(document.getElementById('reviewModalRating').value) || 0;
        stars.forEach(s => {
          s.className = parseInt(s.dataset.rating) <= val ? 'fas fa-star' : 'far fa-star';
          s.style.color = parseInt(s.dataset.rating) <= val ? '#fac451' : '#ccc';
        });
      });
    }

    // Submit review for modal
    const reviewModalSubmitBtn = document.getElementById('reviewModalSubmitBtn');
    if (reviewModalSubmitBtn) {
      reviewModalSubmitBtn.addEventListener('click', () => {
        const rating = parseInt(document.getElementById('reviewModalRating').value);
        const text = document.getElementById('reviewModalText').value.trim();
        const alertEl = document.getElementById('reviewModalAlert');

        if (!rating || rating < 1 || rating > 5) {
          alertEl.className = 'alert alert-danger';
          alertEl.textContent = 'Please select a rating.';
          alertEl.classList.remove('d-none');
          return;
        }
        if (!text) {
          alertEl.className = 'alert alert-danger';
          alertEl.textContent = 'Please write your review.';
          alertEl.classList.remove('d-none');
          return;
        }

        reviewModalSubmitBtn.disabled = true;
        reviewModalSubmitBtn.textContent = 'Submitting...';
        alertEl.classList.add('d-none');

         fetch('{{ url("/product") }}/' + '{{ isset($product) ? $product["slug"] ?? "" : "" }}/review', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ rating, text })
        })
        .then(r => r.json().then(body => ({ status: r.status, body })))
        .then(({ status, body }) => {
          if (status === 401) {
            alertEl.className = 'alert alert-danger';
            alertEl.innerHTML = 'Please <a href="{{ route("login") }}">login</a> to write a review.';
            alertEl.classList.remove('d-none');
            reviewModalSubmitBtn.disabled = false;
            reviewModalSubmitBtn.textContent = 'Submit Review';
          } else if (body.success) {
            toastr.success('Review submitted successfully!');
            const modal = bootstrap.Modal.getInstance(document.getElementById('reviewModal'));
            modal.hide();
            location.reload();
          } else {
            alertEl.className = 'alert alert-danger';
            alertEl.textContent = body.message || 'Something went wrong.';
            alertEl.classList.remove('d-none');
            reviewModalSubmitBtn.disabled = false;
            reviewModalSubmitBtn.textContent = 'Submit Review';
          }
        })
        .catch(() => {
          alertEl.className = 'alert alert-danger';
          alertEl.textContent = 'Something went wrong. Please try again.';
          alertEl.classList.remove('d-none');
          reviewModalSubmitBtn.disabled = false;
          reviewModalSubmitBtn.textContent = 'Submit Review';
        });
      });
    }
  });
</script>
</script>

@endsection
