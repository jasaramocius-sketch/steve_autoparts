                                            'cancelled' => 'bg-danger text-white',
                                            default => 'bg-secondary text-white',
                                        };
                                    @endphp
                                    <span class="badge {{ $badgeClass }} rounded-pill">{{ ucfirst($order->status) }}</span>
                                </td>
                                <td class="pe-3 text-muted">{{ $order->created_at->format('M d, Y') }}</td>
