<script>
$(document).ready(function() {
    function applyCategoriesLayout(layout) {
        if (layout === 'list') {
            $('#listBtn').addClass('active');
            $('#gridBtn').removeClass('active');
            $('#categoryContainer').addClass('categories-list-view');
            $('#categoryContainer > div').removeClass('col-lg-3 col-md-6').addClass('col-12');
            $('#categoryContainer .category-card').addClass('category-card-list');
        } else {
            $('#gridBtn').addClass('active');
            $('#listBtn').removeClass('active');
            $('#categoryContainer').removeClass('categories-list-view');
            $('#categoryContainer > div').removeClass('col-12').addClass('col-lg-3 col-md-6');
            $('#categoryContainer .category-card-list').removeClass('category-card-list');
        }
    }

    var saved = localStorage.getItem('categories_layout');
    if (window.innerWidth <= 576) saved = 'grid';
    applyCategoriesLayout(saved || 'grid');

    $('#gridBtn').on('click', function() {
        applyCategoriesLayout('grid');
        localStorage.setItem('categories_layout', 'grid');
    });
    $('#listBtn').on('click', function() {
        if (window.innerWidth <= 576) return;
        applyCategoriesLayout('list');
        localStorage.setItem('categories_layout', 'list');
    });
});
</script>

<style>
#categoryContainer.categories-list-view .category-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
}
#categoryContainer.categories-list-view .category-card .category-image {
    flex: 0 0 200px;
}
#categoryContainer.categories-list-view .category-card .category-content {
    flex: 1;
}
</style>

