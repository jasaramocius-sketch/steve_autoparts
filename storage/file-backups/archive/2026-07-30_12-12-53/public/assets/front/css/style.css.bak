/*
Theme Name: Genius Shop HTML Template
Author: GeniusOcean
Author URI: https://codecanyon.net/user/geniusocean/portfolio
Tags: Plumbing,blog, agency
Description: Pro-Plamber - Plumbing Service HTML5 Template
Version: 1.0.0
*/
/************************************** base css **************************************/
@import url("https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Saira:ital,wght@0,100..900;1,100..900&display=swap");

html,
body {
  min-height: 100%;
}

:root {
  --blue: #3490f3;
  --gray: #9d9da6;
  --gray-dark: #8d8d8d;
  --secondary: #2d4776;
  --soft-secondary: rgba(145, 145, 153, 0.15);
  --success: #85b567;
  --soft-success: rgba(133, 181, 103, 0.15);
  --warning: #f3af3d;
  --soft-warning: rgba(243, 175, 61, 0.15);
  --light: #f5f5f5;
  --soft-light: #dfdfe6;
  --soft-white: #b5b5bf;
  --dark: #292933;
  --soft-dark: #1b1b28;
  --primary: #e62e04;
  --hov-primary: #af2405;
  --soft-primary: rgba(230, 46, 4, 0.15);
  --secondary-bg-color: #f6f6f6;
  --forest-green: #2e8b57;
}

body {
  margin: 0;
  font-family: "Poppins", sans-serif;
  overflow-x: hidden;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

main {
  flex: 1 0 auto;
}

footer {
  margin-top: auto;
}

input {
  outline: 0;
}

select {
  outline: 0;
  border: 0;
}

a {
  text-decoration: none;
  -webkit-transition: all 0.3s;
  -o-transition: all 0.3s;
  transition: all 0.3s;
  color: var(--primary);
  text-decoration: none !important;
}

.text-primary[href] {
  color: var(--primary) !important;
}

ul {
  list-style-type: none;
  padding: 0;
  margin-bottom: 0;
}

button {
  border: 0;
  background-color: transparent;
  font-family: "Poppins", sans-serif;
  font-size: 16px;
  padding: 12px 24px;
  line-height: 1.2;
  border-radius: 8px;
  cursor: pointer;
  -webkit-transition: all 0.3s ease-in;
  -o-transition: all 0.3s ease-in;
  transition: all 0.3s ease-in;
}
.button-hover:hover {
  background-color: var(--hov-primary);
  color: #ffffff;
}
.a-tag-text-hover:hover {
  color: var(--hov-primary) !important;
}
.primary-a-tag-text-hover:hover{
  color: var(--primary) !important;
  transition: color .3s ease;
}
/* ── Mobile "View All" button ── */
@media (max-width: 767.98px) {
  .steve-btn  {
    /* font-size: 12px !important;
    padding: 8px 24px !important; */
  }
  .admin-dashboard-header .steve-btn, .admin-product-index-search-form .steve-btn {
    padding: 4px 8px !important;
  }
  .admin-product-index-search-form {
    width: 100%;
  }
  .single-product .compare, .single-product-list-view .compare, .single-product .details, .single-product-list-view .details{
    padding:4px !important;
  }
}
@media (max-width: 1212px) {
  .revenue-chart-navbar{
    flex-direction: column;
    gap:5px;
    align-items: flex-start !important;
}
}
.shadow-sm {
  box-shadow: 0 0.125rem 6rem rgba(0, 0, 0, 0.075) !important;
}

.front-header-search {
  display: none;
}

button#searchIcon:hover {
  background-color: #0000;
}
button#searchIcon svg:hover path {
    stroke: var(--primary);
}
button.add-cart,
button.add-to-cart,
.add-cart button,
.add-to-cart button,
.single-product .add-cart,
.single-product-list-view .add-cart {
  font-family: inherit;
  font-size: inherit;
  padding: 12px;
  line-height: inherit;
  border-radius: 8px;
}

.btn-secondary {
  padding: 10px 24px;
}

.single-blog-content-navigation a {
  color: var(--primary);
}

.btn-outline-primary {
  color: var(--primary);
  border-color: var(--primary);
}

.a-tag-hover-color:hover {
  color: var(--secondary) !important;
}
.a-tag-hover-color-red:hover{
  color: var(--primary) !important;
}

.a-tag-hover-color {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  text-decoration: none;
  transition: color .3s ease;
}

.a-tag-hover-color i,
.blog-page-cat-list i {
  transition: transform .3s ease;
}

.gs-brands-section .a-tag-hover-color:hover i {
  color: var(--secondary);
}

.a-tag-hover-color:hover i,
.blog-page-cat-list:hover i {
  transform: translateX(6px);
  color: var(--primary);
}

.single-blog-content-navigation a:hover {
  color: var(--secondary);
}

.a-tag-hover-color:hover i.fas.fa-arrow-left {
  transform: translateX(-6px);
}

.a-tag-hover-color i.fas.fa-arrow-left,
.a-tag-hover-color i.fas.fa-arrow-right {
  color: var(--primary);
}

.a-tag-hover-color:hover i.fas.fa-arrow-left,
.a-tag-hover-color:hover i.fas.fa-arrow-right {
  color: var(--secondary);
}

.steve-btn-hover:hover {
  background-color: var(--hov-primary) !important;
}

.blog-page-cat-list {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  transition: color .3s ease;
}

@media (max-width: 1399px) {
  .shop_details_sidebar {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr 1fr;
  }

  .shop_details_sidebar_info {
    margin-bottom: 0px !important;
  }
}

@media (max-width: 1023px) {

  .container,
  .container-md,
  .container-sm {
    max-width: 960px;
  }
}

@media (min-width: 768px) {
  /* .container {
    padding: 0 !important;
  } */
}

@media (max-width: 576px) {
  /* .container, .container-sm {
        max-width: 90%;
    } */

  .section-with-padding {
    padding: 0 20px;
  }

  .shop_details_sidebar {
    grid-template-columns: 1fr;
  }
}

h1,
h2 {
  font-weight: 700;
  line-height: 120%;
  font-family: "Saira", sans-serif;
  padding: 0;
  margin: 0;
}

h3,
h4,
h5,
h6 {
  font-weight: 600;
  line-height: 130%;
  font-family: "Saira", sans-serif;
  padding: 0;
  margin: 0;
}

h1 {
  font-size: 54px;
}

@media (max-width: 1199.97px) {
  h1 {
    font-size: 32px;
  }
}

@media (max-width: 767.98px) {
  h1 {
    font-size: 24px;
  }
}

h2 {
  font-size: 36px;
}

@media (max-width: 1199.97px) {
  h2 {
    font-size: 28px;
  }
}

h3 {
  font-size: 40px;
  line-height: 120%;
}

@media (max-width: 1199.97px) {
  h3 {
    font-size: 28px;
  }
}

h4 {
  font-size: 32px;
}

@media (max-width: 1199.97px) {
  h4 {
    font-size: 24px;
  }
}

h5 {
  font-size: 18px;
}

@media (max-width: 1199.97px) {
  h5 {
    font-size: 17px;
  }
}

h6 {
  font-size: 20px;
}

@media (max-width: 1199.97px) {
  h6 {
    font-size: 18px;
  }
}

@media (max-width: 767.98px) {
  h6 {
    font-size: 16px;
  }
}

p {
  margin: 0;
  padding: 0;
  font-size: 16px;
  line-height: 170%;
  font-weight: 400;
  font-family: "Poppins", sans-serif;
}

@media (max-width: 1199.97px) {
  p {
    font-size: 14px;
  }
}

p.text-xs {
  font-size: 12px;
}

p.text-lg {
  font-size: 18px;
}

@media (max-width: 1199.97px) {
  p.text-lg {
    font-size: 16px;
  }
}

/* .brands-section-row-first, .best-selling-title-row, .featured-title-row-first{
    padding: 0 20px;
} */
/* Toastr custom colors */
#toast-container>.toast-success {
  background-color: #28a745;
}

#toast-container>.toast-error {
  background-color: #e62e04;
}

#toast-container>.toast-info {
  background-color: #17a2b8;
}

#toast-container>.toast-warning {
  background-color: #ffc107;
  color: #333;
}

/***************** spacing padding *************/

.address-actions-dropdown {
  position: relative;
  display: inline-flex;
  align-items: flex-start;
  justify-content: center;
}

.address-action-toggle {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  /* background: #ffffff; */
  color: #333333;
  font-size: 20px;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
}

.address-actions-dropdown .address-action-toggle {
  color: var(--primary);
}
.address-actions-dropdown:hover .address-action-toggle {
  color: var(--hov-primary);
}
.address-details {
  width: 80%;
}

.address-action-menu {
  position: absolute;
  top: calc(25% + 6px);
  right: 0;
  left: auto;
  /* min-width: 170px; */
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 10px;
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
  z-index: 2;
  /* min-width: 170px; */
  display: flex;
  flex-direction: column;
}

.address-actions-dropdown.open .address-action-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
.h4-style{
    font-size: 1.5rem;
    font-weight: 600;
    color: #1f0300;
}
@media (max-width: 767.98px) {
  .address-actions-dropdown {
    width: 20%;
  }

  .address-action-menu {
    position: absolute;
    top: calc(28% + 8px);
    right: 0;
    /* left: -100px; */
    width: auto;
    min-width: 170px;
    max-width: 100%;
    border-radius: 14px;
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.14);
  }

  .address-action-menu .dropdown-item,
  .address-action-button {
    padding: 12px 16px;
    font-size: 15px;
  }

  .mobile-view-auth-btns .steve-btn {
    padding: 6px 10px;
  }
}

.address-actions {
  text-align: center;
}

.address-action-menu .address-action-item {
  display: block;
  width: 100%;
  padding: 0;
  margin: 0;
}

.address-action-menu .steve-btn {
  width: 100%;
  text-align: left;
  padding: 10px 14px;
  border: 0;
  background: transparent;
  color: #333333;
  font-size: 14px;
  cursor: pointer;
}

/* .address-action-button,
.address-action-menu .address-action-item {
  width: 100%;
  text-align: left;
  padding: 10px 14px;
  border: 0;
  background: transparent;
  color: #333333;
  font-size: 14px;
  cursor: pointer;
} */

.address-action-button:hover,
.address-action-menu .address-action-item:hover {
  background: rgba(0, 0, 0, 0.04);
  color: var(--primary);
}

.custom-address-dropdown {
  position: relative;
}

.custom-address-toggle {
  font-size: 20px;
}

.custom-address-menu {
  /* min-width: 190px; */
  display: flex;
  flex-direction: column;
  padding: 10px;
  gap: 10px;
  max-width: max-content;
  min-width: auto;
}

.custom-address-item {
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.custom-address-item:last-child {
  border-bottom: none;
}

.custom-address-form {
  margin: 0;
}

.custom-address-button {
  width: 100%;
  text-align: left;
}

.custom-address-button.action-btn {
  width: auto;
  text-align: center;
}

.custom-address-delete {
  color: #dc3545;
}

.address-action-button.text-danger {
  color: #dc3545;
}

.address-action-menu form {
  margin: 0;
}

.address-action-menu .action-buttons {
  display: flex;
  gap: 8px;
  padding: 8px;
}

.address-action-menu .action-btn {
  flex-shrink: 0;
}

/* Dropdown with action-btn circular icons */
.custom-address-menu .custom-address-form {
  margin: 0;
}

.custom-address-menu .custom-address-form .action-btn,
.custom-address-menu .custom-address-item .action-btn {
  width: 36px;
  height: 36px;
  min-width: 36px;
  text-align: center;
}

.custom-address-menu .custom-address-form .action-btn svg,
.custom-address-menu .custom-address-item .action-btn svg {
  width: 16px;
  height: 16px;
}

