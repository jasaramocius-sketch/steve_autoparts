document.querySelectorAll('.change-qty').forEach(button => {
  button.addEventListener('click', function () {
    const action = this.getAttribute('data-action');

    // Find the parent item container safely
    const itemContainer = this.closest('.cart-item');

    // CATCH THE ERROR: If the HTML structure is missing, alert the dev instead of crashing
    if (!itemContainer) {
      console.error("Error: Could not find a parent element with class '.cart-item'. Please check your HTML structure.");
      return;
    }

    const itemId = itemContainer.getAttribute('data-id');
    const qtyInput = itemContainer.querySelector('.qty-input');

    if (!qtyInput) {
      console.error("Error: Could not find an input element with class '.qty-input' inside the cart item.");
      return;
    }

    let currentQty = parseInt(qtyInput.value) || 1;

    if (action === 'increase') {
      currentQty++;
    } else if (action === 'decrease' && currentQty > 1) {
      currentQty--;
    } else {
      return;
    }

    // Perform the AJAX request to update the quantity in session
    const csrfTokenEl = document.querySelector('meta[name="csrf-token"]');
    const csrfToken = csrfTokenEl ? csrfTokenEl.getAttribute('content') : '';

    fetch(`/stautoparts/cart/update/${itemId}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-TOKEN': csrfToken
      },
      body: JSON.stringify({ quantity: currentQty })
    })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          qtyInput.value = currentQty;

          // Update item subtotal in table
          const subtotalElement = document.getElementById(`prc${itemId}`);
          if (subtotalElement) {
            subtotalElement.textContent = data.itemSubtotal;
          }

          // Update summary subtotal
          const totalSubElement = document.querySelector('.total-cart-price-sub');
          if (totalSubElement) {
            totalSubElement.textContent = data.cartTotal;
          }

          // Update summary total
          const totalValElement = document.querySelector('.total-cart-price-val');
          if (totalValElement) {
            totalValElement.textContent = data.cartTotal;
          }

          // Optional: show a small toastr notification
          if (typeof toastr !== 'undefined') {
            toastr.success('Cart updated successfully!');
          }
        } else {
          if (typeof toastr !== 'undefined') {
            toastr.error('Failed to update quantity.');
          }
        }
      })
      .catch(error => {
        console.error('Error updating cart:', error);
        if (typeof toastr !== 'undefined') {
          toastr.error('An error occurred while updating the cart.');
        }
      });
  });
});
