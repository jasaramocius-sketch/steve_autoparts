$(document).ready(function () {
  /*
  1. DATA BACKGROUND SET
  2. MOBILE MENU
  3. STICKY HEADER
  4. SEARCH BAR 
  5. NICE SELECT
  6. WOW JS 
  7. HIDE & SHOW PASSWORD 
  8. COUNTDOWN STARTS
  9. HERO SECTION SLIDER
  10. HOME CATE SLIDER
  11. PRODUCT DETAILS SLIDER
  12. PRICE RANGE SLIDER
  13. ADD DYNAMIC CLASS FOR SVG
