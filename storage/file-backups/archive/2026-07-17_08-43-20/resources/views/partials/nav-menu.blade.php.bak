@php
    $currentUrl = url()->current();
    $menu = $menu ?? [];
    $megaCategories = $megaCategories ?? collect();
@endphp
@foreach($menu as $item)
    @php
        $label = $item['label'] ?? '';
        $url = $item['url'] ?? '#';
        $children = $item['children'] ?? [];
        $isMegamenu = !empty($item['megamenu']);
        $hasChildren = !empty($children);
        $isActive = $currentUrl === url($url) || $currentUrl === url($url . '/');
        $liClass = $isMegamenu ? 'has-megamenu' : ($hasChildren ? 'has-submenu' : '');
    @endphp

    <li class="{{ $liClass }}">
        <div class="menu-item-with-icon">
        <a href="{{ $url === '#' ? 'javascript:void(0)' : url($url) }}" class="nav-link{{ $isActive ? ' active' : '' }}">{{ $label }}</a>
        @if($isMegamenu || $hasChildren)
            <span class="has-submenu-icon">
                <i class="fas fa-chevron-down"></i>
            </span></div>
            @if($isMegamenu && !empty($children))
                <div class="megamenu cat-megamenu">
                    <div class="row w-100">
                        @if(!empty($children))
                            @foreach($children as $col)
                                <div class="col-lg-4">
                                    <div class="single-menu mt-30">
                                        <h5><a href="{{ url($col['url'] ?? '#') }}">{{ $col['label'] ?? '' }}</a></h5>
                                        @if(!empty($col['children']))
                                            <ul>
                                                @foreach($col['children'] as $child)
                                                    <li><a href="{{ url($child['url'] ?? '#') }}">{{ $child['label'] ?? '' }}</a></li>
                                                @endforeach
                                            </ul>
                                        @endif
                                    </div>
                                </div>
                            @endforeach
                        @endif
                    </div>
                </div>
            @else
                <ul class="dropdown-menu border-0 shadow">
                    @foreach($children as $child)
                        <li>
                            <a class="dropdown-item dropdown__item" href="{{ url($child['url'] ?? '#') }}">
                                {{ $child['label'] ?? '' }}
                            </a>
                        </li>
                    @endforeach
                </ul>
            @endif
        @else
            </div>
        @endif
    </li>
@endforeach
