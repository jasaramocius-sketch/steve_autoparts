@php
    $size = $size ?? null;
    $navItem = $navItem ?? false;
    $showClear = $showClear ?? (bool)request('search');
    $clearRoute = $clearRoute ?? $route;
@endphp
@if($navItem)<li class="nav-item admin-product-index-search-form ms-lg-auto">@endif
<form action="{{ $route }}" method="GET" class="d-flex gap-2 align-items-center">
    <div class="input-group{{ $size ? ' input-group-' . $size : '' }}">
        <button type="submit" class="input-group-text bg-white">
            <i class="fas fa-search"></i>
        </button>
        <input type="text"
               name="search"
               class="form-control"
               placeholder="{{ $placeholder }}"
               value="{{ request('search') }}">
    </div>
    @if($showClear)
        <a href="{{ $clearRoute }}" class="btn btn-lg btn-outline-danger d-flex align-items-center">
            <i class="fas fa-times"></i>
        </a>
    @endif
</form>
@if($navItem)</li>@endif