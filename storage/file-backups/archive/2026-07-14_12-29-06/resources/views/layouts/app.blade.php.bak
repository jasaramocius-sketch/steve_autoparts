            <!-- Category Sidebar -->
            <div class="hover-category-menu position-absolute w-100 top-100 left-0 right-0 z-3 d-none" id="click-category-menu">
                <div class="container">
                    <div class="d-flex position-relative">
                        <div class="position-static">
                            <div class="aiz-category-menu bg-white rounded-0 border-top" id="category-sidebar" style="width:270px;">
                                <ul class="list-unstyled categories mb-0 text-left">
                                    @php
                                        $parents = \App\Models\Category::has('children')
                                            ->with(['children' => function ($q) {
                                                $q->withCount('products')->orderBy('name');
                                            }])
                                            ->withCount('products')
                                            ->orderBy('name')
                                            ->get();

                                        $leafWithProducts = \App\Models\Category::doesntHave('children')
                                            ->whereHas('products')
                                            ->withCount('products')
                                            ->orderBy('name')
                                            ->get();

                                        $topCategories = $parents->concat($leafWithProducts);
                                        $catColors = ['#e62e04','#2196F3','#4CAF50','#FF9800','#9C27B0','#00BCD4','#E91E63','#607D8B','#795548','#3F51B5','#009688','#FF5722','#673AB7','#03A9F4','#8BC34A','#FFC107','#F44336','#00ACC1','#5C6BC0','#26A69A'];
                                    @endphp
                                    @foreach($topCategories as $index => $category)
                                        @php
                                            $catColor = $catColors[$index % count($catColors)];
                                            $hasChildren = $category->children->count() > 0;
                                            $totalProducts = $category->total_products_count;
                                        @endphp
                                         <li class="category-nav-element border border-top-0 {{ $hasChildren ? 'has-children' : '' }}" data-id="{{ $category->id }}">
                                            <a href="{{ route('category', $category->slug) }}" class="text-truncate text-dark px-4 fs-14 d-block category-nav-link">
                                                @if($category->image)
                                                    {!! imgTag('assets/images/categories/' . $category->image, $category->name, 'mr-2 opacity-60', 'width="16"') !!}
                                                    <span class="mr-2 rounded-circle d-none align-items-center justify-content-center text-white fw-700 cat-color-badge" style="--cat-color: {{ $catColor }};">{{ strtoupper(substr($category->name, 0, 1)) }}</span>
                                                @else
                                                    <span class="mr-2 rounded-circle d-inline-flex align-items-center justify-content-center text-white fw-700 cat-color-badge" style="--cat-color: {{ $catColor }};">{{ strtoupper(substr($category->name, 0, 1)) }}</span>
                                                @endif
                                                <span class="cat-name has-transition">{{ $category->name }}</span>
                                                <span class="ml-1 text-secondary fs-12">({{ $totalProducts }})</span>
                                                @if($hasChildren)
                                                    <span class="ml-auto"><i class="las la-angle-right text-secondary"></i></span>
                                                @endif
                                            </a>
                                        </li>
                                    @endforeach
                                </ul>

                                <!-- Sub-category flyout panels (outside the scrollable ul) -->
                                @foreach($parents as $category)
                                    <div class="sub-cat-panel sub-cat-menu c-scrollbar-light border p-4 shadow-none bg-white d-none" data-subcat-of="{{ $category->id }}">
                                        <h6 class="fw-700 fs-14 mb-3 text-primary border-bottom pb-2">{{ $category->name }}</h6>
                                        <ul class="list-unstyled mb-0">
                                            @foreach($category->children as $child)
                                                <li class="mb-2">
                                                    <a href="{{ route('category', $child->slug) }}" class="text-dark fs-13 d-block py-1 sub-cat-link">
                                                        {{ $child->name }}
                                                        <span class="ml-1 text-secondary fs-12">({{ $child->products_count ?? 0 }})</span>
                                                    </a>
                                                </li>
                                            @endforeach
                                        </ul>
                                        <a href="{{ route('category', $category->slug) }}" class="d-block mt-3 fs-13 fw-700 text-primary">
                                            View All {{ $category->name }} <i class="las la-arrow-right"></i>
                                        </a>
                                    </div>
                                @endforeach
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
